#!/usr/bin/env node
/**
 * No `.js` extension deliberately, matching `bin/temporal-node-red`'s
 * convention (both are Node CLI entrypoints, not library modules, and this
 * repo's `test/unit/_spec.js` coverage-lint only requires a `_spec.js` for
 * extensionless-vs-`.js` library files, not one-off CLI scripts under
 * `bin/`/`demo/`).
 *
 * M8 recovery-demo-only worker entrypoint. NOT a replacement for the M7 CLI
 * (`bin/temporal-node-red`) - identical to it except it raises the M2
 * `Capture` timeout (`captureOptions.timeoutMs`) from the 5s production
 * default to 20s, because this milestone's flow variant
 * (`flows.recovery-demo.json`) inserts a real 10s `delay` node to create a
 * human-reactable kill window, which would otherwise exceed the 5s default
 * and fail the node with NODE_TIMEOUT before the recovery scenario can even
 * be observed. No `lib/*.js` production code is touched; `createWorker`
 * already supports `captureOptions` as a public option (see worker.js), this
 * script just exercises it for a one-off ops scenario. Also logs
 * `process.pid` so worker #1 vs worker #2 can be told apart in transcripts.
 */

"use strict";

const { createWorker } = require("../lib/worker");

const TASK_QUEUE = "node-red-temporal";
const ADDRESS = process.env.TEMPORAL_ADDRESS || "127.0.0.1:7233";
const flow = process.argv[2];

if (!flow) {
    console.error("usage: run-recovery-worker.js <flow.json>");
    process.exit(1);
}

(async () => {
    console.log(`[recovery-demo] pid=${process.pid} starting worker for ${flow} against ${ADDRESS}`);
    const result = await createWorker(flow, {
        workerOptions: { taskQueue: TASK_QUEUE },
        captureOptions: { timeoutMs: 20000 }
    });
    console.log(`[recovery-demo] pid=${process.pid} worker connected, flowVersion=${result.flowVersion}, taskQueue=${TASK_QUEUE}`);
    await result.worker.run();
})().catch((err) => {
    console.error(`[recovery-demo] pid=${process.pid} worker crashed:`, err);
    process.exit(1);
});
