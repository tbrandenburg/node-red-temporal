#!/usr/bin/env node
"use strict";

const args = process.argv.slice(2);

if (args.includes("--help") || args.includes("-h")) {
    console.log("Usage: temporal-node-red [options]");
    console.log("");
    console.log("Options:");
    console.log("  -h, --help   Show this help message and exit");
    process.exit(0);
}

console.error("not yet implemented");
process.exit(1);
