#!/usr/bin/env node
/**
 * M7 CLI: two real commands over M6's worker/workflow wiring, plus the
 * existing M1 `--help` stub (unchanged).
 *
 *   node-red-temporal --flow ./flows.json
 *     Boots a worker (createWorker) and runs its real Worker.run() loop
 *     (long-running foreground process) against the Temporal server at
 *     TEMPORAL_ADDRESS (default 127.0.0.1:7233).
 *
 *   node-red-temporal start --flow ./flows.json --start-node <id> --input '<json>'
 *     Starts a new `executeFlow` Workflow Execution via @temporalio/client,
 *     printing the generated Workflow ID and exiting 0/1 on start success/
 *     failure.
 */

"use strict";

const fs = require("fs");
const { createWorker } = require("../lib/worker");
const { extractWireGraph } = require("../lib/wireGraph");
const { computeFlowVersion } = require("../lib/bootstrap");

const TASK_QUEUE = "node-red-temporal";
const ADDRESS = process.env.TEMPORAL_ADDRESS || "127.0.0.1:7233";

function parseArgs(args) {
    const out = {};
    for (let i = 0; i < args.length; i += 1) {
        const arg = args[i];
        if (arg.startsWith("--")) {
            const key = arg.slice(2);
            const next = args[i + 1];
            const hasValue = next !== undefined && !next.startsWith("--");
            out[key] = hasValue ? next : true;
            if (hasValue) i += 1;
        }
    }
    return out;
}

function printHelp() {
    console.log("Usage: node-red-temporal [options]");
    console.log("");
    console.log("Options:");
    console.log("  -h, --help   Show this help message and exit");
    console.log("");
    console.log("Commands:");
    console.log("  node-red-temporal --flow <path>                             run a worker (blocking)");
    console.log("  node-red-temporal start --flow <path> --start-node <id> --input <json>  start a workflow");
}

async function runWorker(opts) {
    if (!opts.flow) {
        throw new Error("--flow <path> is required");
    }
    const result = await createWorker(opts.flow, { workerOptions: { taskQueue: TASK_QUEUE } });
    console.log(`worker connected, flowVersion=${result.flowVersion}, taskQueue=${TASK_QUEUE}`);
    await result.worker.run();
}

async function runStart(opts) {
    if (!opts.flow || !opts["start-node"] || !opts.input) {
        throw new Error("start requires --flow <path> --start-node <id> --input <json>");
    }
    // eslint-disable-next-line global-require
    const { Client, Connection } = require("@temporalio/client");
    const flows = JSON.parse(fs.readFileSync(opts.flow, "utf8"));
    const graph = extractWireGraph(flows);
    const flowVersion = computeFlowVersion(flows);
    const startMsg = JSON.parse(opts.input);

    const connection = await Connection.connect({ address: ADDRESS });
    const client = new Client({ connection });
    const workflowId = `node-red-temporal-${Date.now()}`;
    const handle = await client.workflow.start("executeFlow", {
        taskQueue: TASK_QUEUE,
        workflowId,
        args: [{ graph, flowVersion, startNode: opts["start-node"], startMsg }]
    });
    console.log(`started workflow ${handle.workflowId} (runId ${handle.firstExecutionRunId})`);
}

async function main() {
    const args = process.argv.slice(2);
    if (args.includes("--help") || args.includes("-h")) {
        printHelp();
        return;
    }

    if (args[0] === "start") {
        await runStart(parseArgs(args.slice(1)));
        return;
    }

    const opts = parseArgs(args);
    if (opts.flow) {
        await runWorker(opts);
        return;
    }

    console.error("not yet implemented");
    process.exit(1);
}

main().catch((err) => {
    console.error(err && err.message ? err.message : err);
    process.exit(1);
});
