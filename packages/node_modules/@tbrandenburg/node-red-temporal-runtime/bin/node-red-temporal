#!/usr/bin/env node
/**
 * M7/issue-16 CLI: real commands over worker.js's role factories.
 *
 *   node-red-temporal --flow ./flows.json
 *   node-red-temporal worker --role combined --flow ./flows.json
 *     Combined role (today's default/compatibility behavior): Node-RED +
 *     Activities + Workflows in one process/Worker.
 *
 *   node-red-temporal worker --role workflow
 *     Workflow-only role: registers `executeFlow` Workflow code, never
 *     boots Node-RED. `--flow` is not accepted/required for this role.
 *
 *   node-red-temporal worker --role activity --flow ./flows.json
 *     Activity-only role: boots Node-RED, installs Capture (source
 *     ingress), registers `executeNode`, polls only the Activity Task Queue.
 *
 *   node-red-temporal start --flow ./flows.json --start-node <id> --input '<json>'
 *     Starts a new `executeFlow` Workflow Execution via @temporalio/client,
 *     printing the generated Workflow ID and exiting 0/1 on start success/
 *     failure.
 *
 * Normal Temporal configuration (address, namespace, Workflow/Activity Task
 * Queues) is accepted via `--address`/`--namespace`/`--workflow-task-queue`/
 * `--activity-task-queue` flags or `TEMPORAL_ADDRESS`/`TEMPORAL_NAMESPACE`/
 * `TEMPORAL_WORKFLOW_TASK_QUEUE`/`TEMPORAL_ACTIVITY_TASK_QUEUE` env vars,
 * with today's local defaults preserved when neither is given (see
 * `resolveTemporalConfig` in `lib/worker.js`, the single source of truth
 * both this CLI and `worker.js` read from).
 *
 * Arg parsing uses node:util's built-in `parseArgs` (stable since Node 20,
 * no new dependency), supporting both `--key value` and `--key=value`.
 */

"use strict";

const fs = require("fs");
const path = require("path");
const { parseArgs: nodeParseArgs } = require("util");
const {
    createCombinedWorker,
    createWorkflowWorker,
    createActivityWorker,
    resolveTemporalConfig
} = require("../lib/worker");
const { extractWireGraph, extractNodeMeta } = require("../lib/wireGraph");
const { computeFlowVersion } = require("../lib/bootstrap");

const PARSE_ARGS_OPTIONS = {
    help: { type: "boolean", short: "h" },
    version: { type: "boolean" },
    flow: { type: "string" },
    "start-node": { type: "string" },
    input: { type: "string" },
    role: { type: "string" },
    address: { type: "string" },
    namespace: { type: "string" },
    "workflow-task-queue": { type: "string" },
    "activity-task-queue": { type: "string" },
    "admin-port": { type: "string" },
    "admin-host": { type: "string" },
    "user-dir": { type: "string" },
    settings: { type: "string" },
    "node-timeout-ms": { type: "string" },
    "http-ingress-port": { type: "string" },
    "http-ingress-host": { type: "string" },
    "http-sync-timeout-ms": { type: "string" }
};

function parseArgs(args) {
    const { values } = nodeParseArgs({
        args,
        options: PARSE_ARGS_OPTIONS,
        allowPositionals: true,
        strict: false
    });
    return values;
}

function readVersion() {
    const pkg = JSON.parse(fs.readFileSync(path.join(__dirname, "..", "package.json"), "utf8"));
    return pkg.version;
}

function printHelp() {
    console.log("Usage: node-red-temporal [options]");
    console.log("");
    console.log("Options:");
    console.log("  -h, --help                    Show this help message and exit");
    console.log("      --version                 Print the version number and exit");
    console.log("      --address <host:port>     Temporal server address (default: 127.0.0.1:7233, env TEMPORAL_ADDRESS)");
    console.log("      --namespace <ns>          Temporal namespace (default: default, env TEMPORAL_NAMESPACE)");
    console.log("      --workflow-task-queue <q> Workflow Task Queue (default: node-red-temporal, env TEMPORAL_WORKFLOW_TASK_QUEUE)");
    console.log("      --activity-task-queue <q> Activity Task Queue (default: node-red-temporal, env TEMPORAL_ACTIVITY_TASK_QUEUE)");
    console.log("      --admin-port <port>       (issue #39) run this process as a runner: expose Node-RED's Admin API");
    console.log("                                (editor disabled) so a separate Node-RED editor can deploy to it");
    console.log("      --admin-host <host>       Host/interface for --admin-port to bind to (default: all interfaces)");
    console.log("      --user-dir <path>         (issue #46) stable Node-RED userDir to boot from (default: a fresh temp dir,");
    console.log("                                env NODE_RED_TEMPORAL_USER_DIR). Reuse the same path across restarts to keep");
    console.log("                                installed nodes, credentials, and persisted context.");
    console.log("      --settings <path>         (issue #46) path to a normal Node-RED settings.js, required()'d and passed");
    console.log("                                through unchanged (env NODE_RED_TEMPORAL_SETTINGS)");
    console.log("      --node-timeout-ms <ms>    Node-RED invocation timeout in ms (default: 60000, env NODE_RED_TEMPORAL_NODE_TIMEOUT_MS)");
    console.log("      --http-ingress-port <port> (issue #58) expose the HTTP ingress/egress transport on this port (opt-in,");
    console.log("                                no default - omit to disable, env NODE_RED_TEMPORAL_HTTP_INGRESS_PORT)");
    console.log("      --http-ingress-host <host> Host/interface for --http-ingress-port to bind to (default: 127.0.0.1,");
    console.log("                                env NODE_RED_TEMPORAL_HTTP_INGRESS_HOST)");
    console.log("      --http-sync-timeout-ms <ms> Bound (ms) for the HTTP sync route's wait on the workflow result");
    console.log("                                (default: 60000, env NODE_RED_TEMPORAL_HTTP_SYNC_TIMEOUT_MS)");
    console.log("");
    console.log("Commands:");
    console.log("  node-red-temporal --flow <path>                                          run a combined worker (blocking, compat)");
    console.log("  node-red-temporal worker --role combined|workflow|activity --flow <path>  run a worker in the given role (blocking)");
    console.log("  node-red-temporal start --flow <path> --start-node <id> --input <json>    start a workflow");
}

function temporalOptionsFrom(opts) {
    return {
        address: opts.address,
        namespace: opts.namespace,
        workflowTaskQueue: opts["workflow-task-queue"],
        activityTaskQueue: opts["activity-task-queue"]
    };
}

/**
 * issue #39 (M2): translates `--admin-port`/`--admin-host` into the
 * `bootstrapOptions.adminApi` shape `bootstrap()` expects. Returns
 * `undefined` when `--admin-port` was not given, so `hasAdminApi()` (used to
 * reject `--admin-port` for `--role workflow`) stays accurate even now that
 * `bootstrapOptionsFrom()` also returns non-undefined for `--user-dir`/
 * `--settings` alone.
 * @param {object} opts
 * @returns {{port:number, host:(string|undefined)}|undefined}
 */
function adminApiOptionsFrom(opts) {
    if (opts["admin-port"] === undefined) {
        return undefined;
    }
    const port = Number(opts["admin-port"]);
    if (!Number.isInteger(port) || port < 0) {
        throw new Error(`--admin-port must be a non-negative integer, got "${opts["admin-port"]}"`);
    }
    return { port, host: opts["admin-host"] };
}

/**
 * issue #46: translates `--user-dir`/`--settings` (or their
 * `NODE_RED_TEMPORAL_USER_DIR`/`NODE_RED_TEMPORAL_SETTINGS` env fallbacks)
 * into `bootstrapOptions.userDir`/`bootstrapOptions.settings`. The settings
 * file is a plain Node-RED `settings.js` (a CommonJS module exporting an
 * object, the same convention the stock Node-RED CLI uses) - it is
 * `require()`'d unchanged, never parsed. `--user-dir` is resolved to an
 * absolute path before being handed to `bootstrap()`, which creates it if
 * missing.
 * @param {object} opts
 * @returns {{userDir:(string|undefined), settings:(object|undefined)}}
 */
function userDirAndSettingsFrom(opts) {
    const userDirInput = opts["user-dir"] || process.env.NODE_RED_TEMPORAL_USER_DIR;
    const settingsInput = opts.settings || process.env.NODE_RED_TEMPORAL_SETTINGS;
    const result = {};
    if (userDirInput) {
        result.userDir = path.resolve(userDirInput);
    }
    if (settingsInput) {
        // eslint-disable-next-line global-require
        result.settings = require(path.resolve(settingsInput));
    }
    return result;
}

/**
 * Combines `--admin-port`/`--admin-host` and `--user-dir`/`--settings` into
 * the single `{bootstrapOptions}` shape `createActivityWorker()`/
 * `createCombinedWorker()` expect. Returns `undefined` (not an empty
 * object) when none of these were given, so callers can safely spread this
 * into `options` without accidentally enabling the Admin API server or
 * overriding defaults.
 * @param {object} opts
 * @returns {{bootstrapOptions:object}|undefined}
 */
function bootstrapOptionsFrom(opts) {
    const adminApi = adminApiOptionsFrom(opts);
    const { userDir, settings } = userDirAndSettingsFrom(opts);
    if (adminApi === undefined && userDir === undefined && settings === undefined) {
        return undefined;
    }
    const bootstrapOptions = {};
    if (adminApi !== undefined) {
        bootstrapOptions.adminApi = adminApi;
    }
    if (userDir !== undefined) {
        bootstrapOptions.userDir = userDir;
    }
    if (settings !== undefined) {
        bootstrapOptions.settings = settings;
    }
    return { bootstrapOptions };
}

/**
 * issue #47: resolves the single runner-level node execution timeout from
 * `--node-timeout-ms`, falling back to the `NODE_RED_TEMPORAL_NODE_TIMEOUT_MS`
 * env var, then `undefined` (letting `lib/worker.js`/`lib/workflows.js` apply
 * their own default) when neither is given. Kept separate from
 * `bootstrapOptionsFrom`/`temporalOptionsFrom` so this file's existing
 * option-mapping functions stay untouched.
 * @param {object} opts
 * @returns {number|undefined}
 */
function nodeTimeoutMsFrom(opts) {
    const raw = opts["node-timeout-ms"] !== undefined ? opts["node-timeout-ms"] : process.env.NODE_RED_TEMPORAL_NODE_TIMEOUT_MS;
    if (raw === undefined) {
        return undefined;
    }
    const ms = Number(raw);
    if (!Number.isInteger(ms) || ms <= 0) {
        throw new Error(`--node-timeout-ms must be a positive integer, got "${raw}"`);
    }
    return ms;
}

/**
 * issue #58 M5: translates `--http-ingress-port`/`--http-ingress-host`/
 * `--http-sync-timeout-ms` (or their `NODE_RED_TEMPORAL_HTTP_INGRESS_PORT`/
 * `NODE_RED_TEMPORAL_HTTP_INGRESS_HOST`/`NODE_RED_TEMPORAL_HTTP_SYNC_TIMEOUT_MS`
 * env fallbacks) into the `{port, host, syncTimeoutMs}` shape
 * `createActivityWorker()`/`createCombinedWorker()` expect via
 * `options.httpIngress`. Returns `undefined` (not an empty object) when
 * `--http-ingress-port` was not given, keeping HTTP ingress fully opt-in.
 * @param {object} opts
 * @returns {{port:number, host:(string|undefined), syncTimeoutMs:(number|undefined)}|undefined}
 */
function httpIngressOptionsFrom(opts) {
    const portRaw = opts["http-ingress-port"] !== undefined ? opts["http-ingress-port"] : process.env.NODE_RED_TEMPORAL_HTTP_INGRESS_PORT;
    if (portRaw === undefined) {
        return undefined;
    }
    const port = Number(portRaw);
    if (!Number.isInteger(port) || port < 0) {
        throw new Error(`--http-ingress-port must be a non-negative integer, got "${portRaw}"`);
    }
    const host = opts["http-ingress-host"] || process.env.NODE_RED_TEMPORAL_HTTP_INGRESS_HOST;

    const syncTimeoutRaw = opts["http-sync-timeout-ms"] !== undefined ? opts["http-sync-timeout-ms"] : process.env.NODE_RED_TEMPORAL_HTTP_SYNC_TIMEOUT_MS;
    let syncTimeoutMs;
    if (syncTimeoutRaw !== undefined) {
        syncTimeoutMs = Number(syncTimeoutRaw);
        if (!Number.isInteger(syncTimeoutMs) || syncTimeoutMs <= 0) {
            throw new Error(`--http-sync-timeout-ms must be a positive integer, got "${syncTimeoutRaw}"`);
        }
    }

    return { port, host, syncTimeoutMs };
}

/**
 * issue #16: registers SIGINT/SIGTERM handlers that call the given role's
 * own `stop()` (reusing the real Temporal Worker shutdown + Node-RED
 * `stop()` paths already exposed by worker.js - no new drain protocol) and
 * then exit cleanly, so container orchestration (`docker stop`, Kubernetes
 * SIGTERM, Ctrl-C) tears the process down gracefully instead of being
 * killed mid-flight.
 *
 * @param {{stop: function(): Promise<void>}} role
 */
function installShutdownHandlers(role) {
    let shuttingDown = false;
    function shutdown(signal) {
        if (shuttingDown) {
            return;
        }
        shuttingDown = true;
        console.log(`[node-red-temporal] received ${signal}, shutting down...`);
        role.stop().then(() => {
            process.exit(0);
        }, (err) => {
            console.error(`[node-red-temporal] error during shutdown: ${err && err.message ? err.message : err}`);
            process.exit(1);
        });
    }
    process.on("SIGINT", () => shutdown("SIGINT"));
    process.on("SIGTERM", () => shutdown("SIGTERM"));
}

async function runWorker(opts) {
    const role = opts.role || "combined";
    const temporal = temporalOptionsFrom(opts);
    const bootstrapOptions = bootstrapOptionsFrom(opts);
    const nodeExecutionTimeoutMs = nodeTimeoutMsFrom(opts);
    const httpIngress = httpIngressOptionsFrom(opts);

    if (role === "workflow") {
        if (adminApiOptionsFrom(opts)) {
            throw new Error("--admin-port is not supported for --role workflow (the workflow role never boots Node-RED)");
        }
        if (httpIngress) {
            throw new Error("--http-ingress-port is not supported for --role workflow (the workflow role never boots Node-RED)");
        }
        const result = await createWorkflowWorker({ temporal });
        console.log(`workflow worker connected, taskQueue=${result.temporalConfig.workflowTaskQueue}, address=${result.temporalConfig.address}, namespace=${result.temporalConfig.namespace}`);
        installShutdownHandlers(result);
        await result.worker.run();
        return;
    }

    if (role === "activity") {
        if (!opts.flow) {
            throw new Error("--flow <path> is required for --role activity");
        }
        const result = await createActivityWorker(opts.flow, Object.assign({ temporal, nodeExecutionTimeoutMs, httpIngress }, bootstrapOptions));
        console.log(`activity worker connected, flowVersion=${result.flowVersion}, taskQueue=${result.temporalConfig.activityTaskQueue}, address=${result.temporalConfig.address}, namespace=${result.temporalConfig.namespace}`);
        if (result.handle.adminApiAddress) {
            console.log(`admin API listening on http://${result.handle.adminApiAddress.address}:${result.handle.adminApiAddress.port}/ (editor disabled)`);
        }
        if (result.httpIngressAddress) {
            console.log(`http ingress listening on http://${result.httpIngressAddress.host}:${result.httpIngressAddress.port}/ (async: POST .../http/async/:startNodeId, sync: POST .../http/sync/:startNodeId/:resultNodeId)`);
        }
        installShutdownHandlers(result);
        await result.worker.run();
        return;
    }

    if (role !== "combined") {
        throw new Error(`unknown --role "${role}" (expected combined, workflow, or activity)`);
    }

    if (!opts.flow) {
        throw new Error("--flow <path> is required");
    }
    const result = await createCombinedWorker(opts.flow, Object.assign({ temporal, nodeExecutionTimeoutMs, httpIngress }, bootstrapOptions));
    console.log(`worker connected, flowVersion=${result.flowVersion}, workflowTaskQueue=${result.temporalConfig.workflowTaskQueue}, activityTaskQueue=${result.temporalConfig.activityTaskQueue}`);
    if (result.handle.adminApiAddress) {
        console.log(`admin API listening on http://${result.handle.adminApiAddress.address}:${result.handle.adminApiAddress.port}/ (editor disabled)`);
    }
    if (result.httpIngressAddress) {
        console.log(`http ingress listening on http://${result.httpIngressAddress.host}:${result.httpIngressAddress.port}/ (async: POST .../http/async/:startNodeId, sync: POST .../http/sync/:startNodeId/:resultNodeId)`);
    }
    installShutdownHandlers(result);
    const runs = [result.worker.run()];
    if (result.workflowWorker) {
        runs.push(result.workflowWorker.worker.run());
    }
    await Promise.all(runs);
}

async function runStart(opts) {
    if (!opts.flow || !opts["start-node"] || !opts.input) {
        throw new Error("start requires --flow <path> --start-node <id> --input <json>");
    }
    // eslint-disable-next-line global-require
    const { Client, Connection } = require("@temporalio/client");
    const temporalConfig = resolveTemporalConfig(temporalOptionsFrom(opts));
    const flows = JSON.parse(fs.readFileSync(opts.flow, "utf8"));
    const graph = extractWireGraph(flows);
    const nodeMeta = extractNodeMeta(flows);
    const flowVersion = computeFlowVersion(flows);
    // No explicit `flowId` concept exists elsewhere in this codebase (issue
    // #6 item 4): the flow *file*'s basename (without extension) is used as
    // a reasonable, always-available stand-in for observability purposes
    // only (memo/staticSummary) - it is never used for routing or matching.
    const flowId = path.basename(opts.flow, path.extname(opts.flow));
    let startMsg;
    try {
        startMsg = JSON.parse(opts.input);
    } catch (err) {
        throw new Error(`invalid JSON for --input: ${err.message}`);
    }

    const connection = await Connection.connect({ address: temporalConfig.address });
    const client = new Client({ connection, namespace: temporalConfig.namespace });
    const workflowId = `node-red-temporal-${Date.now()}`;
    const handle = await client.workflow.start("executeFlow", {
        taskQueue: temporalConfig.workflowTaskQueue,
        workflowId,
        args: [{ graph, nodeMeta, flowVersion, startNode: opts["start-node"], startMsg, activityTaskQueue: temporalConfig.activityTaskQueue, nodeExecutionTimeoutMs: nodeTimeoutMsFrom(opts) }],
        memo: { flowId, flowVersion, startNode: opts["start-node"] },
        staticSummary: `${flowId}@${flowVersion.slice(0, 12)} from ${opts["start-node"]}`
    });
    console.log(`started workflow ${handle.workflowId} (runId ${handle.firstExecutionRunId})`);
}

async function main() {
    const args = process.argv.slice(2);
    if (args.includes("--help") || args.includes("-h")) {
        printHelp();
        return;
    }

    if (args.includes("--version")) {
        console.log(readVersion());
        return;
    }

    if (args[0] === "start") {
        await runStart(parseArgs(args.slice(1)));
        return;
    }

    if (args[0] === "worker") {
        await runWorker(parseArgs(args.slice(1)));
        return;
    }

    const opts = parseArgs(args);
    if (opts.flow) {
        await runWorker(opts);
        return;
    }

    console.error("not yet implemented");
    process.exit(1);
}

if (require.main === module) {
    main().catch((err) => {
        console.error(err && err.message ? err.message : err);
        process.exit(1);
    });
}

module.exports = { parseArgs, printHelp, readVersion, runWorker, runStart, main, nodeTimeoutMsFrom, httpIngressOptionsFrom };
